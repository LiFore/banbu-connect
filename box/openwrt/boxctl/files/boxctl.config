config panel 'panel'
	option https_port '8443'
	option http_port '8080'
	option data_dir '/etc/boxctl'
	# TUN 不接管的网段（LAN 网段总是不接管）：经 WireGuard 等其他接口访问的网段写在这里，走系统路由。
	# 例：uci add_list boxctl.panel.route_exclude='10.99.0.0/16'; uci commit boxctl
	# list route_exclude '10.99.0.0/16'
	# 客户端自动发现路由盒（ADR-073）：dnsmasq 把 banbu-box.lan 解析到 LAN 地址，面板在 LAN 地址的 19443 端口应答。
	# 开着发现时，LAN 地址的 19444 端口还有一个给客户端的代理入口（SOCKS5 / HTTP，ADR-084），
	# 客户端经它把非直连的流量交给路由盒，旁路由、跨网段也能用；密码由口令派生，没有口令的设备用不了。
	# 绑定了管理服务时口令随配置自动下发，不用填；没绑定时填管理服务「线路与规则」里的路由盒口令。
	# 关闭：uci set boxctl.panel.discovery='0'; uci commit boxctl
	option discovery '1'
	# option discovery_secret ''
	# 路由盒 ID：客户端按它记住出口，多台路由盒要各不相同；空则用主机名。
	# option discovery_id 'home-box'
