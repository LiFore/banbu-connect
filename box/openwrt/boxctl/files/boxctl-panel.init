#!/bin/sh /etc/rc.common
# Web 管理面板（只监听 LAN 地址，M1-07）。内核是独立服务 boxctl-core（ADR-045），面板只生成配置、
# 热重载、启停它：重启或升级面板不影响内核。以 root 运行：要启停内核服务、改 guard 策略。

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/boxctl

# lan_subnet 输出 LAN 网段（如 192.168.100.0/24），TUN 不接管它，面板和 SSH 始终直达。
lan_subnet() {
	local ip mask
	ip="$(uci -q get network.lan.ipaddr)"
	mask="$(uci -q get network.lan.netmask)"
	case "$ip" in
	*/*) mask="${ip#*/}"; ip="${ip%%/*}" ;;
	esac
	[ -n "$ip" ] || return
	[ -x /bin/ipcalc.sh ] || { echo "$ip/32"; return; }
	eval "$(/bin/ipcalc.sh "$ip" "${mask:-255.255.255.0}")"
	echo "$NETWORK/$PREFIX"
}

# route_excludes 输出 TUN 不接管的全部网段（逗号分隔）：LAN 网段，加上配置里的 route_exclude。
# 经路由盒其他接口（WireGuard 等 VPN）访问的网段要加进去：TUN 接管后内核的 DIRECT 从 WAN 出去，到不了 VPN。
route_excludes() {
	local nets
	nets="$(lan_subnet)"
	add_exclude() { nets="${nets:+$nets,}$1"; }
	config_list_foreach panel route_exclude add_exclude
	echo "$nets"
}

DISCOVERY_NAME=banbu-box.lan
DISCOVERY_PORT=19443

# discovery_dns 让 dnsmasq 把发现用的名字解析到 LAN 地址（ADR-073）；参数为空时删除记录。只在变化时重载 dnsmasq。
discovery_dns() {
	local want="$1" cur
	cur="$(uci -q get dhcp.boxctl_discovery.ip)"
	if [ -n "$want" ]; then
		[ "$cur" = "$want" ] && [ "$(uci -q get dhcp.boxctl_discovery.name)" = "$DISCOVERY_NAME" ] && return
		uci -q batch <<-EOF
			set dhcp.boxctl_discovery=domain
			set dhcp.boxctl_discovery.name='$DISCOVERY_NAME'
			set dhcp.boxctl_discovery.ip='$want'
			commit dhcp
		EOF
	else
		[ -n "$cur" ] || return
		uci -q delete dhcp.boxctl_discovery
		uci -q commit dhcp
	fi
	/etc/init.d/dnsmasq reload >/dev/null 2>&1
}

# is_off 判断 uci 布尔值是否为关（未设置按 $2 处理）。
is_off() {
	case "${1:-$2}" in
	0 | false | off | no | disabled) return 0 ;;
	esac
	return 1
}

# dnsmasq_rfc6761 关掉 dnsmasq 的 boguspriv（ADR-081）：打开时 OpenWrt 加载 rfc6761.conf，其中 server=/local/
# 让 .local 只在本地应答，上级本地 DNS 里的 xxx.local 查不到。bogus-priv 和其余保留后缀由 guard 的片段补回。
# 用 boxctl_boguspriv 标记是 boxctl 关的，卸载时恢复；用户原本就关着的不动。返回 0 表示由 boxctl 接管。
dnsmasq_rfc6761() {
	local cur mark
	cur="$(uci -q get dhcp.@dnsmasq[0].boguspriv)"
	mark="$(uci -q get dhcp.@dnsmasq[0].boxctl_boguspriv)"
	if [ "$mark" = 1 ]; then
		is_off "$cur" 1 && return 0
		# 接管后用户又在 LuCI 里打开了：尊重用户的设置，不再接管
		uci -q delete dhcp.@dnsmasq[0].boxctl_boguspriv
		uci -q commit dhcp
		return 1
	fi
	is_off "$cur" 1 && return 1
	uci -q batch <<-EOF
		set dhcp.@dnsmasq[0].boguspriv='0'
		set dhcp.@dnsmasq[0].boxctl_boguspriv='1'
		commit dhcp
	EOF
	# boguspriv 决定加载哪些配置文件，reload 只发 HUP 不会重读，要 restart
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	return 0
}

start_service() {
	local https_port http_port data_dir lan_ip discovery discovery_secret discovery_id
	config_load boxctl
	config_get_bool discovery panel discovery 1
	config_get discovery_secret panel discovery_secret
	config_get discovery_id panel discovery_id
	config_get https_port panel https_port 8443
	config_get http_port panel http_port 8080
	config_get data_dir panel data_dir /etc/boxctl
	lan_ip="$(uci -q get network.lan.ipaddr)"
	lan_ip="${lan_ip%%/*}"
	lan_ip="${lan_ip:-127.0.0.1}"

	procd_open_instance panel
	procd_set_param command "$PROG" panel \
		-listen "$lan_ip:$https_port" \
		-http-listen "$lan_ip:$http_port" \
		-data-dir "$data_dir" \
		-guard-sock /var/run/boxctl/guard.sock \
		-status-sock /var/run/boxctl/panel.sock \
		-core-init /etc/init.d/boxctl-core \
		-core-pidfile /var/run/boxctl/core.pid \
		-core-log /var/run/boxctl/core.log \
		-route-exclude "$(route_excludes)"
	dnsmasq_rfc6761 && procd_append_param command -dnsmasq-rfc6761
	if [ "$discovery" = 1 ] && [ "$lan_ip" != 127.0.0.1 ]; then
		procd_append_param command -discovery-listen "$lan_ip:$DISCOVERY_PORT"
		[ -n "$discovery_id" ] && procd_append_param command -discovery-id "$discovery_id"
		# 口令经环境变量传，不出现在进程列表里；为空时用管理服务下发的。
		[ -n "$discovery_secret" ] && procd_set_param env BOXCTL_DISCOVERY_SECRET="$discovery_secret"
		discovery_dns "$lan_ip"
	else
		discovery_dns ""
	fi
	procd_set_param respawn 3600 1 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger boxctl network
}
